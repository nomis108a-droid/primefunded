
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shared check for Administrative authority
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() in [
        'sitarama108a@gmail.com',
        'sitarama108a-alt@gmail.com',
        'nomis108a@gmail.com',
        'pawanvish0907@gmail.com',
        'radhakrishna200803@gmail.com',
        'rachithraj133@gmail.com'
      ];
    }

    // KYC Document Security: Owner-only write, Owner+Admin read
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Payment Proof Security: Owner-only write, Owner+Admin read
    match /payment-proofs/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Featured Payout Proofs: Public read, Admin write
    match /featured-payout-proofs/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
