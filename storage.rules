
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public path for payout evidence
    match /payouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: Authenticated access for trader documents
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
