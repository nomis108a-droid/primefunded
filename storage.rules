
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payout Evidence: Public Read, Authenticated Write
    match /payouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Catch-all: Authenticated access for staff operations
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
