rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payout Evidence: Public Read, Auth Write for Admin
    match /payouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /featured-payout-proofs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Identity Documents
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Payment Confirmation screenshots
    match /payment-proofs/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global fallback: Authenticated access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}