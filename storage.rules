
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated staff to perform all operations
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Public read access for payout evidence on the leaderboard
    match /payouts/{allPaths=**} {
      allow read: if true;
    }
    match /featured-payout-proofs/{allPaths=**} {
      allow read: if true;
    }
  }
}
