rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Featured Payout Proofs: Publicly viewable, Authenticated uploads
    match /payouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private KYC and Payment Proofs: Owner or Staff access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}