
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payout Proofs: Public Read, Authenticated Write
    match /payouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Featured Payouts Evidence: Public Read, Authenticated Write
    match /featured-payout-proofs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // KYC & Evidence: Owner Read/Write, Admin Read (Relaxed for Terminal)
    match /kyc/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    match /payment-proofs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default catch-all for authenticated users (Staff)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
