
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrative Access: Permissive for authenticated users (Staff)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public Reads for leaderboard and payouts
    match /payouts/{id} {
      allow read: if true;
    }
    match /featured_payouts/{id} {
      allow read: if true;
    }
    match /livePrices/{id} {
      allow read: if true;
    }
    match /settings/branding {
      allow read: if true;
    }
  }
}
