
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive access for authenticated users (Staff/Admins)
    // This ensures administrative operations are never blocked by ownership checks.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public Reads for leaderboard and feeds
    match /payouts/{id} {
      allow read: if true;
    }
    match /featured_payouts/{id} {
      allow read: if true;
    }
    match /livePrices/{id} {
      allow read: if true;
    }
    match /settings/branding {
      allow read: if true;
    }
    
    // User-specific read/write for standard functionality
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /referrals/{id} {
      allow read: if request.auth != null && (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid);
    }
  }
}
