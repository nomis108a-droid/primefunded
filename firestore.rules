rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is in the authorized admin email list (case-insensitive)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() in [
          "sitarama108a@gmail.com",
          "sitarama108a-alt@gmail.com",
          "nomis108a@gmail.com",
          "pawanvish0907@gmail.com",
          "radhakrishna200803@gmail.com",
          "rachithraj133@gmail.com"
        ];
    }


    // Site Settings (branding, config)
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Unified Market Feed
    match /market/{symbol} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || request.auth.uid == resource.data.userId));
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // User Management & Challenges (Explicit matches for administrative reliability)
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null;
      }
      
      match /notifications/{notifId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow recursive access for any other subcollections
      match /{allPaths=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Referral System
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /referrals/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // Payouts
    match /payouts/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Featured Payouts (Public Leaderboard)
    match /featured_payouts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Trading Terminal Data
    match /livePrices/{symbol} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /demoAccounts/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /demoTrades/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    // Giveaway System
    match /giveaways/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // Global System Collections
    match /broadcasts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /breaches/{id} {
      allow read, write: if isAdmin();
    }

    match /error_logs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    match /activity_logs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    match /_system/{document=**} {
      allow read, write: if isAdmin();
    }

    match /_locks/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
  }
}