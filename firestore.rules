
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Featured Payouts: Public Read, Authenticated Write
    match /payouts/{payoutId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // User Profiles & Subcollections: Authenticated access for staff
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Trading Nodes & Trades: Authenticated access for staff
    match /demoAccounts/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /demoTrades/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Global Broadcasts & Settings: Public Read, Authenticated Write
    match /broadcasts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default: Authenticated access for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
