
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Featured Payouts: Public Read, Authenticated Write
    match /payouts/{payoutId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default: Authenticated access for all other documents (Permissive for Staff)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
