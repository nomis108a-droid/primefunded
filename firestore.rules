
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is in the authorized admin email list
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "sitarama108a@gmail.com" ||
        request.auth.token.email == "nomis108a@gmail.com" ||
        request.auth.token.email == "Pawanvish0907@gmail.com" ||
        request.auth.token.email == "radhakrishna200803@gmail.com" ||
        request.auth.token.email == "rachithraj133@gmail.com"
      );
    }

    // Public read for system-wide sync (protected by app layer)
    match /{document=**} {
      allow read: if true;
    }

    // Orders Collection: Users can create/read own, admins can manage all
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // KYC and User Management
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Giveaway Claims
    match /giveaways/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Mail collection for system emails
    match /mail/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Referrals and Commissions
    match /referrals/{id} {
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // Price Feeds and Terminal Data
    match /livePrices/{symbol} {
      allow write: if true;
    }

    match /demoAccounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /demoTrades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    // Global Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
