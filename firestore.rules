rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Payouts: Public can see featured entries, authenticated users can create/manage
    match /payouts/{payoutId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User Data: Authenticated users can manage profiles and sub-collections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Trading Data: Nodes and executions must be accessible by staff
    match /demoAccounts/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /demoTrades/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default: Allow authenticated access for administrative oversight
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}