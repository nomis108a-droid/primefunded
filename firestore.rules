rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is in the authorized admin email list
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          "sitarama108a@gmail.com",
          "sitarama108a-alt@gmail.com",
          "nomis108a@gmail.com",
          "Pawanvish0907@gmail.com",
          "radhakrishna200803@gmail.com",
          "rachithraj133@gmail.com"
        ]
      );
    }

    // Public read for system-wide sync (protected by app layer)
    match /{document=**} {
      allow read: if true;
    }

    // Unified Market Feed
    match /market/{symbol} {
      allow read: if true;
      allow write: if true; // Background sync processes
    }

    // Orders Collection: Users can create/read own, admins can manage all
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // KYC and User Management
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Referral System
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Giveaway Claims
    match /giveaways/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Mail collection for system emails
    match /mail/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Referrals and Commissions
    match /referrals/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // Payouts Hub
    match /payouts/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Price Feeds and Terminal Data
    match /livePrices/{symbol} {
      allow read: if true;
      allow write: if true;
    }

    match /demoAccounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /demoTrades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    // Global System Collections
    match /broadcasts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /_system/{document=**} {
      allow read, write: if isAdmin();
    }

    match /_locks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
